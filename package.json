{
  "name": "@berrybrands/iridium",
  "version": "0.1.0-rc.1",
  "description": "A console shell and admin primitives for React and Radix Themes: an entrance grid of areas, a header with search, breadcrumbs, an Option+Tab area switcher, a two-level navigation rail, side panels and data tables.",
  "license": "MIT",
  "author": "BerryBrands",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BerryBrands/iridium.git"
  },
  "homepage": "https://github.com/BerryBrands/iridium#readme",
  "bugs": "https://github.com/BerryBrands/iridium/issues",
  "keywords": [
    "react",
    "radix-ui",
    "admin",
    "console",
    "dashboard",
    "navigation",
    "data-table"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react-router": {
      "types": "./dist/types/react-router.d.ts",
      "import": "./dist/react-router.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "dev": "vite --config example/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@radix-ui/themes": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@radix-ui/themes": "^3.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.18.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.4"
  }
}
